# ===================================================
# Imperial Hospital & Trauma Centre - SMTP Configuration Template
# ===================================================

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls

# SMTP Credentials
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Sender & Recipient Information
SMTP_FROM_NAME=imperialhospitalandtraumacentre
SMTP_FROM_EMAIL=your_email@gmail.com
MAIL_TO_EMAIL=your_email@gmail.com
